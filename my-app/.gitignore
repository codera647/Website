# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/assets
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext build output
/.open-next/
/.wrangler/
.dev.vars

# cloudflare-env.d.ts is intentionally committed — Cloudflare's git-connected
# build needs its ambient D1Database/R2Bucket/Ai/etc. types at build time
# (there's no `wrangler types` pre-build step in that pipeline). Regenerate
# with `npm run cf-typegen` after changing wrangler.jsonc bindings.

implementation_plan.md
task.md

# supabase CLI local state — machine-specific project link/version cache,
# never secrets themselves but not meant to be shared across machines
supabase/.temp
supabase/.branches

# stray scratch/temp files
*.tmp