{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kinetiq-website",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    // Enable Node.js API (required — our /api/contact and /api/careers/apply
    // routes use Buffer and File, both Node APIs)
    "nodejs_compat",
    // Allow fetching public URLs (used by Resend's SDK)
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // must match "name" above
      "service": "kinetiq-website"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinetiq-db",
      "database_id": "7c73c09c-4849-42e9-9bb0-340046d1f70b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kinetiq-rag-sources"
    },
    {
      "binding": "IMAGES_BUCKET",
      // separate from BUCKET (RAG sources auto-reindex into AI Search) —
      // this one holds admin-uploaded project thumbnails/screenshots,
      // served publicly via /api/images/[...path]
      "bucket_name": "kinetiq-images"
    }
  ],
  "images": {
    // enables Cloudflare's image optimization for next/image
    "binding": "IMAGES"
  },
  "ai": {
    // enables Workers AI + AI Search (used by /api/chat for the
    // site-wide and per-project assistants)
    "binding": "AI"
  }
}
